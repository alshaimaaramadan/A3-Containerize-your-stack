# Copy this file to .env and edit the values. .env is gitignored; this file is not.
#
#   cp .env.example .env          # macOS/Linux
#   Copy-Item .env.example .env   # Windows PowerShell

# --- Postgres ---------------------------------------------------------------
# docker compose reads these to create the database on first start, and again
# to build the connection string it hands to the app container.
POSTGRES_USER=taskapi
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=taskapi

# Host port to publish Postgres on. Change it if 5432 is already taken by a
# Postgres you installed natively.
POSTGRES_PORT=5432

# Host port to publish the API on.
APP_PORT=8000

# --- Application ------------------------------------------------------------
# The one setting the app itself reads. This value is for running uvicorn
# directly on your machine, so it points at localhost.
#
# Inside `docker compose up` this is NOT used: compose sets DATABASE_URL for the
# api container with host `db` (the service name on the compose network), because
# `localhost` inside a container means that container, not your laptop.
#
# Keep the password alphanumeric, or percent-encode it — this is a URL, so a raw
# `@`, `:` or `/` in the password will be parsed as structure and the connection
# will fail in a confusing way.
DATABASE_URL=postgresql://taskapi:change-me-locally@localhost:5432/taskapi
